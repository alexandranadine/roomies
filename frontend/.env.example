# Public frontend origins only (scheme + host + optional port). Never put secrets here.
# Used as the browser fetch target for the handwritten API client (credentials: include)
# and as the CSP connect-src allowlist for direct Home-photo object transfer.
#
# Development: if VITE_API_ORIGIN is unset, the app defaults to http://localhost:3000.
# Deployed / production builds: VITE_API_ORIGIN must be set explicitly — there is no
# localhost fallback.
VITE_API_ORIGIN=http://localhost:3000

# Public R2 S3 origin only (scheme://host). No path, wildcard, or credentials.
# Optional in local development. Required in the browser CSP connect-src for real
# Home-photo uploads (R2_PROVIDER=cloudflare). Do not put R2 access keys here.
# Example: https://<account-id>.r2.cloudflarestorage.com
# VITE_R2_S3_ORIGIN=
