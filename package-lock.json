{
  "name": "roomies",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "roomies",
      "version": "0.0.0",
      "workspaces": [
        "frontend",
        "backend",
        "shared"
      ],
      "engines": {
        "node": ">=20",
        "npm": ">=10"
      }
    },
    "backend": {
      "name": "@roomies/backend",
      "version": "0.0.0"
    },
    "frontend": {
      "name": "@roomies/frontend",
      "version": "0.0.0"
    },
