      "resolved": "backend",
      "link": true
    },
    "node_modules/@roomies/frontend": {
      "resolved": "frontend",
      "link": true
    },
    "node_modules/@roomies/shared": {
      "resolved": "shared",
      "link": true
    },
    "shared": {
      "name": "@roomies/shared",
      "version": "0.0.0"
    }
