# Local development only. Copy to `.env` and adjust if needed.
# Actual `.env` files are Git-ignored and must never be committed.
#
# These credentials match compose.yaml (Docker PostgreSQL 18).
# Do not use them for production, staging, Neon, or any deployed environment.
#
# Prisma CLI reads DATABASE_URL via backend/prisma.config.ts.
# Application runtime parses the same variables through backend platform config.

# Roomies deployment environment (not NODE_ENV). Required.
# Allowed: development | test | preview | staging | production
APP_ENV=development

# Backend HTTP listen port (Railway injects PORT in deployed environments).
PORT=3000

# Exact trusted frontend origins (comma-separated). No wildcards.
# Omitted in development/test → defaults to http://localhost:5173 and http://127.0.0.1:5173.
# Required for preview, staging, and production (no localhost defaults).
# TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Express trust-proxy hop count (integer). Default 0 = do not trust X-Forwarded-*.
# Boolean true/false is rejected. On Railway, set an explicit hop count matching the
# edge proxy path (commonly 1; some topologies need 2). Prefer verifying req.ip in
# the deployed environment over assuming a hop count.
# TRUST_PROXY=0

DATABASE_URL=postgresql://roomies:roomies_dev_only@127.0.0.1:5432/roomies
