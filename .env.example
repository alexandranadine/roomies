# Local development only. Copy to `.env` and adjust if needed.
# Actual `.env` files are Git-ignored and must never be committed.
#
# These credentials match compose.yaml (Docker PostgreSQL 18).
# Do not use them for production, staging, Neon, or any deployed environment.
#
# Prisma CLI reads DATABASE_URL via backend/prisma.config.ts.
# Application runtime parses the same variables through backend platform config.
#
# For migration/integration test tooling, prefer a dedicated database and set:
# TEST_DATABASE_URL=postgresql://roomies:roomies_dev_only@127.0.0.1:5432/roomies_test
# (create roomies_test once; never point destructive helpers at the `roomies` DB)

# Roomies deployment environment (not NODE_ENV). Required.
# Allowed: development | test | preview | staging | production
APP_ENV=development

# Backend HTTP listen port (Railway injects PORT in deployed environments).
PORT=3000

# Process role. Allowed: web | worker | combined. Default combined
# (HTTP + recurrence worker in one process). Initial production deployment
# is combined. Do not infer this from other variables.
# PROCESS_MODE=combined

# Recurrence worker poll interval when no immediate due work remains.
# Integer milliseconds from 1000 to 300000. Default 30000.
# RECURRENCE_POLL_INTERVAL_MS=30000

# Exact trusted frontend origins (comma-separated). No wildcards.
# Omitted in development/test → defaults to http://localhost:5173 and http://127.0.0.1:5173.
# Required for preview, staging, and production (no localhost defaults).
# TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Canonical public frontend origin for invite URLs. Omitted in development/test
# defaults to http://localhost:5173. Required for preview, staging, and production.
# FRONTEND_ORIGIN=http://localhost:5173

# Express trust-proxy hop count (integer). Default 0 = do not trust X-Forwarded-*.
# Boolean true/false is rejected. Rate limiting uses Express req.ip under this
# hop count. Do not set a Railway hop count until a deployed probe confirms
# req.ip; guessing 1 is unsafe if the path has a different length.
# TRUST_PROXY=0

DATABASE_URL=postgresql://roomies:roomies_dev_only@127.0.0.1:5432/roomies

# Release-only Prisma CLI URL for preview/staging/production migrate.
# Neon direct / unpooled host (no -pooler). Never put a real production URL here.
# Runtime continues to use DATABASE_URL (prefer Neon pooled + sslmode=require).
# MIGRATION_DATABASE_URL=

# Optional safe release identifier (7-40 hex git SHA). Railway also provides
# RAILWAY_GIT_COMMIT_SHA; RELEASE_SHA wins when both are set.
# RELEASE_SHA=

# Public backend origin used by Better Auth. Local/test default:
# http://localhost:3000. Required explicitly for preview/staging/production.
# AUTH_BASE_URL=http://localhost:3000

# Better Auth signing/encryption secret. Required; at least 32 characters.
# Generate a random deployment-specific value. Never reuse this placeholder.
AUTH_SECRET=replace_with_a_random_secret_of_at_least_32_characters
