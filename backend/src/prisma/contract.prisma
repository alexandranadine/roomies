// use prisma-next

// Roomies core: User, Home, Membership.
// Last-active-Admin (never leave an active Home with zero active Admin
// Memberships during normal structural operations) is a cross-row
// transactional invariant. It is enforced by the application transaction
// layer, not by a CHECK, unique index, or trigger in this contract.

enum MembershipRole {
  @@type("pg/text@1")
  ROOMMATE
  ADMIN
}

enum TaskSource {
  @@type("pg/text@1")
  MANUAL
  RECURRING
}

enum TaskStatus {
  @@type("pg/text@1")
  OPEN
  COMPLETED
}

enum TaskRecurrenceFrequency {
  @@type("pg/text@1")
  DAILY
  WEEKLY
  MONTHLY
}

model User {
  id          Uuid                 @id @default(uuid(7))
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")
  memberships Membership[]
  authIdentity AuthIdentity?

  @@map("users")
}

model Home {
  id          Uuid                 @id @default(uuid(7))
  name        String
  timezone    String
  archivedAt  Timestamptz?         @map("archived_at")
  createdAt   temporal.createdAt() @map("created_at")
  updatedAt   temporal.updatedAt() @map("updated_at")
  memberships      Membership[]
  invitations      Invitation[]
  taskInstances    TaskInstance[]
  taskDefinitions  TaskDefinition[]

  @@map("homes")
}

model Membership {
  id       Uuid            @id @default(uuid(7))
  homeId   Uuid            @map("home_id")
  userId   Uuid            @map("user_id")
  role     MembershipRole
  joinedAt Timestamptz     @default(now()) @map("joined_at")
  endedAt  Timestamptz?    @map("ended_at")

  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "memberships_home_id_fkey")
  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "memberships_user_id_fkey")
  createdInvitations       Invitation[]      @relation("InvitationCreatorMembership")
  acceptedInvitations      Invitation[]      @relation("InvitationAcceptedMembership")
  assignedTaskInstances    TaskInstance[]    @relation("TaskInstanceAssignedMembership")
  assignedTaskDefinitions  TaskDefinition[]  @relation("TaskDefinitionAssignedMembership")
  createdTaskDefinitions   TaskDefinition[]  @relation("TaskDefinitionCreatorMembership")

  // At most one active tenure per (home, user). Ended rows may coexist so
  // leave-and-rejoin creates a new Membership id rather than reopening one.
  @@index([homeId, userId], unique: true, where: "(ended_at IS NULL)", name: "memberships_one_active_per_home_user")
  @@index([homeId, id], unique: true, name: "memberships_home_id_id_key")
  @@index([homeId], name: "memberships_home_id")
  @@index([userId], name: "memberships_user_id")
  @@map("memberships")
}

// Better Auth 1.7.4 persistence. Authentication identity/profile data stays
// separate from the canonical Roomies User and from Home authorization.
model AuthIdentity {
  id            Uuid        @id @default(dbgenerated("gen_random_uuid()"))
  name          String
  email         String
  emailVerified Boolean     @default(false) @map("email_verified")
  image         String?
  createdAt     Timestamptz @default(now()) @map("created_at")
  updatedAt     Timestamptz @default(now()) @map("updated_at")

  user     User          @relation(fields: [id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "auth_identities_id_fkey")
  accounts AuthAccount[]
  sessions AuthSession[]

  @@check(
    expression: "((char_length(email) >= 3) AND (char_length(email) <= 254) AND (email = btrim(email)) AND (email !~ '[A-Z]'::text) AND (email ~ '^[!-~]+$'::text))",
    map: "auth_identities_email_canonical_check"
  )
  @@index([email], unique: true, name: "auth_identities_email_uidx")
  @@map("auth_identities")
}

model Invitation {
  id                      Uuid        @id
  homeId                  Uuid        @map("home_id")
  invitedEmail            String      @map("invited_email")
  tokenHash               Bytes       @map("token_hash")
  createdByMembershipId   Uuid        @map("created_by_membership_id")
  createdAt               Timestamptz @map("created_at")
  expiresAt               Timestamptz @map("expires_at")
  acceptedAt              Timestamptz? @map("accepted_at")
  acceptedMembershipId    Uuid?       @map("accepted_membership_id")
  revokedAt               Timestamptz? @map("revoked_at")
  revocationCause         String?     @map("revocation_cause")

  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "invitations_home_id_fkey")
  createdByMembership Membership @relation("InvitationCreatorMembership", fields: [homeId, createdByMembershipId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitations_creator_home_membership_fkey")
  acceptedMembership Membership? @relation("InvitationAcceptedMembership", fields: [homeId, acceptedMembershipId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "invitations_accepted_home_membership_fkey")

  @@check(
    expression: "((char_length(invited_email) >= 3) AND (char_length(invited_email) <= 254) AND (invited_email = btrim(invited_email)) AND (invited_email !~ '[A-Z]'::text) AND (invited_email ~ '^[!-~]+$'::text))",
    map: "invitations_email_canonical_check"
  )
  @@check(
    expression: "(octet_length(token_hash) = 32)",
    map: "invitations_token_hash_length_check"
  )
  @@check(
    expression: "(expires_at > created_at)",
    map: "invitations_expiry_order_check"
  )
  @@check(
    expression: "((accepted_at IS NULL) = (accepted_membership_id IS NULL))",
    map: "invitations_acceptance_completeness_check"
  )
  @@check(
    expression: "((revoked_at IS NULL) = (revocation_cause IS NULL))",
    map: "invitations_revocation_completeness_check"
  )
  @@check(
    expression: "(NOT ((accepted_at IS NOT NULL) AND (revoked_at IS NOT NULL)))",
    map: "invitations_terminal_state_check"
  )
  @@check(
    expression: "((accepted_at IS NULL) OR ((accepted_at >= created_at) AND (accepted_at < expires_at)))",
    map: "invitations_accepted_time_check"
  )
  @@check(
    expression: "((revoked_at IS NULL) OR ((revoked_at >= created_at) AND (revoked_at < expires_at)))",
    map: "invitations_revoked_time_check"
  )
  @@check(
    expression: "((revocation_cause IS NULL) OR (revocation_cause = ANY (ARRAY['ADMIN_REVOKED'::text, 'HOME_ARCHIVED'::text])))",
    map: "invitations_revocation_cause_check"
  )
  @@index([tokenHash], unique: true, name: "invitations_token_hash_uidx")
  @@index([acceptedMembershipId], unique: true, where: "(accepted_membership_id IS NOT NULL)", name: "invitations_accepted_membership_uidx")
  @@index([createdByMembershipId], name: "invitations_created_by_membership_idx")
  @@index([homeId, expiresAt, createdAt, id], where: "((accepted_at IS NULL) AND (revoked_at IS NULL))", name: "invitations_home_open_idx")
  @@map("invitations")
}

model AuthAccount {
  id                    Uuid         @id @default(dbgenerated("gen_random_uuid()"))
  accountId             String       @map("account_id")
  providerId            String       @map("provider_id")
  userId                Uuid         @map("user_id")
  accessToken           String?      @map("access_token")
  refreshToken          String?      @map("refresh_token")
  idToken               String?      @map("id_token")
  accessTokenExpiresAt  Timestamptz? @map("access_token_expires_at")
  refreshTokenExpiresAt Timestamptz? @map("refresh_token_expires_at")
  scope                  String?
  password               String?
  createdAt              Timestamptz  @default(now()) @map("created_at")
  updatedAt              Timestamptz  @default(now()) @map("updated_at")

  user AuthIdentity @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "auth_accounts_user_id_fkey")

  @@index([userId], name: "auth_accounts_user_id_idx")
  @@map("auth_accounts")
}

model AuthSession {
  id        Uuid        @id @default(dbgenerated("gen_random_uuid()"))
  expiresAt Timestamptz @map("expires_at")
  token     String
  createdAt Timestamptz @default(now()) @map("created_at")
  updatedAt Timestamptz @default(now()) @map("updated_at")
  ipAddress String?     @map("ip_address")
  userAgent String?     @map("user_agent")
  userId    Uuid        @map("user_id")

  user AuthIdentity @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "auth_sessions_user_id_fkey")

  @@index([token], unique: true, name: "auth_sessions_token_uidx")
  @@index([userId], name: "auth_sessions_user_id_idx")
  @@map("auth_sessions")
}

model AuthVerification {
  id         Uuid        @id @default(dbgenerated("gen_random_uuid()"))
  identifier String
  value      String
  expiresAt  Timestamptz @map("expires_at")
  createdAt  Timestamptz @default(now()) @map("created_at")
  updatedAt  Timestamptz @default(now()) @map("updated_at")

  @@index([identifier], name: "auth_verifications_identifier_idx")
  @@map("auth_verifications")
}

// Platform transactional outbox. home_id is routing/context only — no domain FK.
model OutboxEvent {
  eventId       Uuid          @id @map("event_id")
  eventType     VarChar(200)  @map("event_type")
  occurredAt    Timestamptz   @map("occurred_at")
  createdAt     Timestamptz   @default(now()) @map("created_at")
  availableAt   Timestamptz   @default(now()) @map("available_at")
  homeId        Uuid?         @map("home_id")
  payload       Jsonb
  attemptCount  Int           @default(0) @map("attempt_count")
  leaseOwner    Uuid?         @map("lease_owner")
  leasedAt      Timestamptz?  @map("leased_at")
  leaseUntil    Timestamptz?  @map("lease_until")
  processedAt   Timestamptz?  @map("processed_at")
  deadAt        Timestamptz?  @map("dead_at")
  lastFailedAt  Timestamptz?  @map("last_failed_at")
  lastErrorCode VarChar(100)? @map("last_error_code")

  @@check(
    expression: "((event_type)::text ~ '^[a-z][a-z0-9_]*[.][a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)*[.]v[1-9][0-9]*$'::text)",
    map: "outbox_events_event_type_format_check"
  )
  @@check(
    expression: "(jsonb_typeof(payload) = 'object'::text)",
    map: "outbox_events_payload_object_check"
  )
  @@check(expression: "(attempt_count >= 0)", map: "outbox_events_attempt_count_check")
  @@check(
    expression: "(NOT ((processed_at IS NOT NULL) AND (dead_at IS NOT NULL)))",
    map: "outbox_events_terminal_state_check"
  )
  @@check(
    expression: "(((lease_owner IS NULL) AND (leased_at IS NULL) AND (lease_until IS NULL)) OR ((lease_owner IS NOT NULL) AND (leased_at IS NOT NULL) AND (lease_until IS NOT NULL)))",
    map: "outbox_events_lease_completeness_check"
  )
  @@check(
    expression: "((lease_until IS NULL) OR (lease_until > leased_at))",
    map: "outbox_events_lease_order_check"
  )
  @@check(
    expression: "(((processed_at IS NULL) AND (dead_at IS NULL)) OR (lease_owner IS NULL))",
    map: "outbox_events_terminal_not_leased_check"
  )
  @@check(
    expression: "((last_error_code IS NULL) OR ((last_error_code)::text ~ '^[A-Z][A-Z0-9_]{0,99}$'::text))",
    map: "outbox_events_error_code_format_check"
  )
  @@index(
    [availableAt, createdAt, eventId],
    where: "((processed_at IS NULL) AND (dead_at IS NULL))",
    map: "outbox_events_claim_idx"
  )
  @@index(
    [processedAt, eventId],
    where: "(processed_at IS NOT NULL)",
    map: "outbox_events_processed_prune_idx"
  )
  @@index(
    [deadAt, eventId],
    where: "(dead_at IS NOT NULL)",
    map: "outbox_events_dead_prune_idx"
  )
  @@map("outbox_events")
}

// Task persistence. Recurrence math is application/worker runtime later:
// for next calendar date D, D 00:00:00 in Home.timezone is resolved with
// Temporal-compatible "compatible" disambiguation to nextOccurrenceAt
// (normal local time → sole instant; nonexistent → shift forward by the
// timezone gap; ambiguous → earlier instant/offset). Timezone changes
// later preserve the logical next recurrence date and re-resolve it.
// No time-of-day column. No Task outbox events in this contract.
model TaskDefinition {
  id                     Uuid                      @id @default(uuid(7))
  homeId                 Uuid                      @map("home_id")
  title                  String
  assignedMembershipId   Uuid?                     @map("assigned_membership_id")
  creatorMembershipId    Uuid                      @map("creator_membership_id")
  recurrenceFrequency    TaskRecurrenceFrequency   @map("recurrence_frequency")
  recurrenceWeekday      Int?                      @map("recurrence_weekday")
  recurrenceDayOfMonth   Int?                      @map("recurrence_day_of_month")
  nextOccurrenceAt       Timestamptz?              @map("next_occurrence_at")
  deactivatedAt          Timestamptz?              @map("deactivated_at")
  createdAt              temporal.createdAt()      @map("created_at")
  updatedAt              temporal.updatedAt()      @map("updated_at")

  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "task_definitions_home_id_fkey")
  assignedMembership Membership? @relation("TaskDefinitionAssignedMembership", fields: [homeId, assignedMembershipId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "task_definitions_assigned_home_membership_fkey")
  creatorMembership Membership @relation("TaskDefinitionCreatorMembership", fields: [homeId, creatorMembershipId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "task_definitions_creator_home_membership_fkey")
  instances TaskInstance[] @relation("TaskInstanceDefinition")

  @@check(
    expression: "(((recurrence_frequency = 'DAILY'::text) AND (recurrence_weekday IS NULL) AND (recurrence_day_of_month IS NULL)) OR ((recurrence_frequency = 'WEEKLY'::text) AND (recurrence_weekday IS NOT NULL) AND ((recurrence_weekday >= 1) AND (recurrence_weekday <= 7)) AND (recurrence_day_of_month IS NULL)) OR ((recurrence_frequency = 'MONTHLY'::text) AND (recurrence_weekday IS NULL) AND (recurrence_day_of_month IS NOT NULL) AND ((recurrence_day_of_month >= 1) AND (recurrence_day_of_month <= 31))))",
    map: "task_definitions_recurrence_config_check"
  )
  @@check(
    expression: "((deactivated_at IS NULL) = (next_occurrence_at IS NOT NULL))",
    map: "task_definitions_scheduling_lifecycle_check"
  )
  @@check(
    expression: "((deactivated_at IS NULL) OR (deactivated_at >= created_at))",
    map: "task_definitions_deactivated_time_check"
  )
  @@index([homeId, id], unique: true, name: "task_definitions_home_id_id_key")
  @@index([homeId, createdAt, id], where: "(deactivated_at IS NULL)", name: "task_definitions_home_active_idx")
  @@index([nextOccurrenceAt, id], where: "(deactivated_at IS NULL)", name: "task_definitions_worker_due_idx")
  @@index([homeId, creatorMembershipId], name: "task_definitions_home_creator_idx")
  @@index([homeId, assignedMembershipId, id], where: "((deactivated_at IS NULL) AND (assigned_membership_id IS NOT NULL))", name: "task_definitions_home_active_assignee_idx")
  @@map("task_definitions")
}

model TaskInstance {
  id                   Uuid         @id @default(uuid(7))
  homeId               Uuid         @map("home_id")
  source               TaskSource
  status               TaskStatus   @default(OPEN)
  title                String
  scheduledFor         DateString?  @map("scheduled_for")
  assignedMembershipId Uuid?        @map("assigned_membership_id")
  taskDefinitionId     Uuid?        @map("task_definition_id")
  completedAt          Timestamptz? @map("completed_at")
  createdAt            temporal.createdAt() @map("created_at")
  updatedAt            temporal.updatedAt() @map("updated_at")

  home Home @relation(fields: [homeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "task_instances_home_id_fkey")
  assignedMembership Membership? @relation("TaskInstanceAssignedMembership", fields: [homeId, assignedMembershipId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "task_instances_assigned_home_membership_fkey")
  taskDefinition TaskDefinition? @relation("TaskInstanceDefinition", fields: [homeId, taskDefinitionId], references: [homeId, id], onDelete: Restrict, onUpdate: Restrict, map: "task_instances_definition_home_fkey")

  @@check(
    expression: "(((source = 'MANUAL'::text) AND (task_definition_id IS NULL)) OR ((source = 'RECURRING'::text) AND (task_definition_id IS NOT NULL) AND (scheduled_for IS NOT NULL)))",
    map: "task_instances_source_definition_check"
  )
  @@check(
    expression: "(((status = 'OPEN'::text) AND (completed_at IS NULL)) OR ((status = 'COMPLETED'::text) AND (completed_at IS NOT NULL)))",
    map: "task_instances_completion_state_check"
  )
  @@check(
    expression: "((completed_at IS NULL) OR (completed_at >= created_at))",
    map: "task_instances_completed_time_check"
  )
  @@index([homeId, scheduledFor, createdAt, id], where: "(status = 'OPEN')", name: "task_instances_home_open_idx")
  @@index([homeId, completedAt, id], where: "(status = 'COMPLETED')", name: "task_instances_home_completed_idx")
  @@index([homeId, assignedMembershipId, id], where: "((status = 'OPEN') AND (assigned_membership_id IS NOT NULL))", name: "task_instances_home_open_assignee_idx")
  @@index([taskDefinitionId, scheduledFor], unique: true, where: "(task_definition_id IS NOT NULL)", name: "task_instances_definition_occurrence_uidx")
  @@map("task_instances")
}
