      {
        "description": "create table \"supply_claims\"",
        "sql": "CREATE TABLE \"public\".\"supply_claims\" (\n  \"claimant_membership_id\" uuid NOT NULL,\n  \"claimed_at\" timestamptz NOT NULL,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"release_reason\" text,\n  \"released_at\" timestamptz,\n  \"supply_entry_id\" uuid NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"supply_claims_release_completeness_check\" CHECK (((released_at IS NULL) = (release_reason IS NULL))),\n  CONSTRAINT \"supply_claims_release_reason_check_d17b2d97\" CHECK (\"release_reason\" IN ('CLAIMANT_RELEASED', 'MEMBERSHIP_ENDED', 'ENTRY_OBTAINED', 'ENTRY_CANCELED')),\n  CONSTRAINT \"supply_claims_released_time_check\" CHECK (((released_at IS NULL) OR ((released_at >= claimed_at) AND (released_at >= created_at))))\n)",
        "params": []
      }
    ],
    "postcheck": [
