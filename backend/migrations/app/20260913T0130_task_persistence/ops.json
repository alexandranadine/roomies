        "description": "create table \"task_instances\"",
        "sql": "CREATE TABLE \"public\".\"task_instances\" (\n  \"assigned_membership_id\" uuid,\n  \"completed_at\" timestamptz,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"scheduled_for\" date,\n  \"source\" text NOT NULL,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"task_definition_id\" uuid,\n  \"title\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"task_instances_completed_time_check\" CHECK (((completed_at IS NULL) OR (completed_at >= created_at))),\n  CONSTRAINT \"task_instances_completion_state_check\" CHECK ((((status = 'OPEN'::text) AND (completed_at IS NULL)) OR ((status = 'COMPLETED'::text) AND (completed_at IS NOT NULL)))),\n  CONSTRAINT \"task_instances_source_check_2dc6a827\" CHECK (\"source\" IN ('MANUAL', 'RECURRING')),\n  CONSTRAINT \"task_instances_source_definition_check\" CHECK ((((source = 'MANUAL'::text) AND (task_definition_id IS NULL)) OR ((source = 'RECURRING'::text) AND (task_definition_id IS NOT NULL) AND (scheduled_for IS NOT NULL)))),\n  CONSTRAINT \"task_instances_status_check_6df9db95\" CHECK (\"status\" IN ('OPEN', 'COMPLETED'))\n)",
