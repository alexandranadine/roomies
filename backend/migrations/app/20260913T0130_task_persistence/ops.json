    ],
    "execute": [
      {
        "description": "create table \"task_definitions\"",
        "sql": "CREATE TABLE \"public\".\"task_definitions\" (\n  \"assigned_membership_id\" uuid,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"creator_membership_id\" uuid NOT NULL,\n  \"deactivated_at\" timestamptz,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"next_occurrence_at\" timestamptz,\n  \"recurrence_day_of_month\" int4,\n  \"recurrence_frequency\" text NOT NULL,\n  \"recurrence_weekday\" int4,\n  \"title\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"task_definitions_deactivated_time_check\" CHECK (((deactivated_at IS NULL) OR (deactivated_at >= created_at))),\n  CONSTRAINT \"task_definitions_recurrence_config_check\" CHECK ((((recurrence_frequency = 'DAILY'::text) AND (recurrence_weekday IS NULL) AND (recurrence_day_of_month IS NULL)) OR ((recurrence_frequency = 'WEEKLY'::text) AND (recurrence_weekday IS NOT NULL) AND ((recurrence_weekday >= 1) AND (recurrence_weekday <= 7)) AND (recurrence_day_of_month IS NULL)) OR ((recurrence_frequency = 'MONTHLY'::text) AND (recurrence_weekday IS NULL) AND (recurrence_day_of_month IS NOT NULL) AND ((recurrence_day_of_month >= 1) AND (recurrence_day_of_month <= 31))))),\n  CONSTRAINT \"task_definitions_recurrence_frequency_check_979d6261\" CHECK (\"recurrence_frequency\" IN ('DAILY', 'WEEKLY', 'MONTHLY')),\n  CONSTRAINT \"task_definitions_scheduling_lifecycle_check\" CHECK (((deactivated_at IS NULL) = (next_occurrence_at IS NOT NULL)))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"task_definitions\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"task_definitions\""
        ]
      }
    ]
  },
