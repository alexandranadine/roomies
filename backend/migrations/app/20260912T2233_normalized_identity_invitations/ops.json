  {
    "id": "table.invitations",
    "label": "Create table \"invitations\"",
    "summary": "Creates table \"invitations\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "invitations"
      }
    },
    "precheck": [
      {
        "description": "ensure table \"invitations\" does not exist",
        "sql": "SELECT (to_regclass($1)) IS NULL AS \"result\"",
        "params": [
          "\"public\".\"invitations\""
        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"invitations\"",
        "sql": "CREATE TABLE \"public\".\"invitations\" (\n  \"accepted_at\" timestamptz,\n  \"accepted_membership_id\" uuid,\n  \"created_at\" timestamptz NOT NULL,\n  \"created_by_membership_id\" uuid NOT NULL,\n  \"expires_at\" timestamptz NOT NULL,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"invited_email\" text NOT NULL,\n  \"revocation_cause\" text,\n  \"revoked_at\" timestamptz,\n  \"token_hash\" bytea NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"invitations_acceptance_completeness_check\" CHECK (((accepted_at IS NULL) = (accepted_membership_id IS NULL))),\n  CONSTRAINT \"invitations_accepted_time_check\" CHECK (((accepted_at IS NULL) OR ((accepted_at >= created_at) AND (accepted_at < expires_at)))),\n  CONSTRAINT \"invitations_email_canonical_check\" CHECK (((char_length(invited_email) >= 3) AND (char_length(invited_email) <= 254) AND (invited_email = btrim(invited_email)) AND (invited_email !~ '[A-Z]'::text) AND (invited_email ~ '^[!-~]+$'::text))),\n  CONSTRAINT \"invitations_expiry_order_check\" CHECK ((expires_at > created_at)),\n  CONSTRAINT \"invitations_revocation_cause_check\" CHECK (((revocation_cause IS NULL) OR (revocation_cause = ANY (ARRAY['ADMIN_REVOKED'::text, 'HOME_ARCHIVED'::text])))),\n  CONSTRAINT \"invitations_revocation_completeness_check\" CHECK (((revoked_at IS NULL) = (revocation_cause IS NULL))),\n  CONSTRAINT \"invitations_revoked_time_check\" CHECK (((revoked_at IS NULL) OR ((revoked_at >= created_at) AND (revoked_at < expires_at)))),\n  CONSTRAINT \"invitations_terminal_state_check\" CHECK ((NOT ((accepted_at IS NOT NULL) AND (revoked_at IS NOT NULL)))),\n  CONSTRAINT \"invitations_token_hash_length_check\" CHECK ((octet_length(token_hash) = 32))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"invitations\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"invitations\""
        ]
      }
    ]
  },
  {
    "id": "checkConstraint.auth_identities.auth_identities_email_canonical_check",
    "label": "Add check constraint \"auth_identities_email_canonical_check\" on \"auth_identities\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "checkConstraint",
        "name": "auth_identities_email_canonical_check",
        "table": "auth_identities"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"auth_identities_email_canonical_check\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "auth_identities_email_canonical_check",
          "public",
          "\"public\".\"auth_identities\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add check constraint \"auth_identities_email_canonical_check\"",
        "sql": "ALTER TABLE \"public\".\"auth_identities\" ADD CONSTRAINT \"auth_identities_email_canonical_check\" CHECK (((char_length(email) >= 3) AND (char_length(email) <= 254) AND (email = btrim(email)) AND (email !~ '[A-Z]'::text) AND (email ~ '^[!-~]+$'::text)))"
      }
    ],
    "postcheck": [
