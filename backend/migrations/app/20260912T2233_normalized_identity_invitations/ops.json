[
  {
    "id": "data.public.auth_identities.normalize_canonical_email",
    "label": "Audit and normalize canonical auth identity emails",
    "operationClass": "additive",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "refuse normalized collisions or unsupported stored email values",
        "sql": "SELECT (\n  NOT EXISTS (\n    SELECT 1\n    FROM public.auth_identities\n    GROUP BY pg_catalog.lower(pg_catalog.btrim(email))\n    HAVING COUNT(*) > 1\n  )\n  AND NOT EXISTS (\n    SELECT 1\n    FROM public.auth_identities\n    WHERE pg_catalog.char_length(pg_catalog.lower(pg_catalog.btrim(email))) NOT BETWEEN 3 AND 254\n       OR pg_catalog.lower(pg_catalog.btrim(email)) !~ '^[!-~]+$'::text\n  )\n) AS \"result\"",
        "params": []
      }
    ],
    "execute": [
      {
        "description": "store every auth email in canonical form",
        "sql": "UPDATE public.auth_identities\nSET email = pg_catalog.lower(pg_catalog.btrim(email))\nWHERE email IS DISTINCT FROM pg_catalog.lower(pg_catalog.btrim(email))",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify canonical auth email storage and uniqueness",
        "sql": "SELECT (\n  NOT EXISTS (\n    SELECT 1\n    FROM public.auth_identities\n    WHERE email IS DISTINCT FROM pg_catalog.lower(pg_catalog.btrim(email))\n  )\n  AND NOT EXISTS (\n    SELECT 1\n    FROM public.auth_identities\n    GROUP BY email\n    HAVING COUNT(*) > 1\n  )\n) AS \"result\"",
        "params": []
      }
    ]
  },
