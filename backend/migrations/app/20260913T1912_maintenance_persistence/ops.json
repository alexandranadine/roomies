    "execute": [
      {
        "description": "create table \"maintenance_entries\"",
        "sql": "CREATE TABLE \"public\".\"maintenance_entries\" (\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"created_by_membership_id\" uuid NOT NULL,\n  \"details\" text,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"resolved_at\" timestamptz,\n  \"resolved_by_membership_id\" uuid,\n  \"status\" text DEFAULT 'OPEN' NOT NULL,\n  \"title\" text NOT NULL,\n  \"updated_at\" timestamptz NOT NULL,\n  \"visibility\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"maintenance_entries_details_canonical_check\" CHECK (((details IS NULL) OR ((char_length(details) >= 1) AND (char_length(details) <= 4000) AND (details = btrim(details))))),\n  CONSTRAINT \"maintenance_entries_lifecycle_check\" CHECK ((((status = 'OPEN'::text) AND (resolved_by_membership_id IS NULL) AND (resolved_at IS NULL)) OR ((status = 'RESOLVED'::text) AND (resolved_by_membership_id IS NOT NULL) AND (resolved_at IS NOT NULL)))),\n  CONSTRAINT \"maintenance_entries_resolved_time_check\" CHECK (((resolved_at IS NULL) OR ((resolved_at >= created_at) AND (resolved_at <= updated_at)))),\n  CONSTRAINT \"maintenance_entries_status_check_2a206a64\" CHECK (\"status\" IN ('OPEN', 'RESOLVED')),\n  CONSTRAINT \"maintenance_entries_title_canonical_check\" CHECK (((char_length(title) >= 1) AND (char_length(title) <= 120) AND (title = btrim(title)))),\n  CONSTRAINT \"maintenance_entries_updated_time_check\" CHECK ((updated_at >= created_at)),\n  CONSTRAINT \"maintenance_entries_visibility_check_b1f71ccd\" CHECK (\"visibility\" IN ('HOUSEHOLD', 'PRIVATE'))\n)",
        "params": []
      }
