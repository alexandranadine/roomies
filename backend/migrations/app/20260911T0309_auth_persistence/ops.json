  {
    "id": "function.public.provision_user_for_auth_identity",
    "label": "Create auth identity canonical User provisioning function",
    "operationClass": "additive",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "ensure provisioning function does not exist",
        "sql": "SELECT to_regprocedure($1) IS NULL AS \"result\"",
        "params": [
          "public.provision_user_for_auth_identity()"
        ]
      }
    ],
    "execute": [
      {
        "description": "create canonical User provisioning function",
        "sql": "CREATE FUNCTION public.provision_user_for_auth_identity()\nRETURNS trigger\nLANGUAGE plpgsql\nSECURITY INVOKER\nSET search_path = pg_catalog\nAS $function$\nBEGIN\n  INSERT INTO public.users (id, updated_at)\n  VALUES (NEW.id, CURRENT_TIMESTAMP);\n\n  RETURN NEW;\nEND;\n$function$",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify canonical User provisioning function contract",
        "sql": "SELECT EXISTS (\n  SELECT 1\n  FROM pg_catalog.pg_proc AS p\n  INNER JOIN pg_catalog.pg_namespace AS n ON n.oid = p.pronamespace\n  INNER JOIN pg_catalog.pg_language AS l ON l.oid = p.prolang\n  WHERE n.nspname = 'public'\n    AND p.proname = 'provision_user_for_auth_identity'\n    AND p.pronargs = 0\n    AND p.prorettype = 'pg_catalog.trigger'::pg_catalog.regtype\n    AND p.prosecdef = false\n    AND l.lanname = 'plpgsql'\n    AND COALESCE(p.proconfig, ARRAY[]::text[]) @> ARRAY['search_path=pg_catalog']\n    AND POSITION(\n      'insert into public.users (id, updated_at) values (new.id, current_timestamp);'\n      IN pg_catalog.regexp_replace(pg_catalog.lower(p.prosrc), '[[:space:]]+', ' ', 'g')\n    ) > 0\n    AND POSITION(\n      'return new;'\n      IN pg_catalog.regexp_replace(pg_catalog.lower(p.prosrc), '[[:space:]]+', ' ', 'g')\n    ) > 0\n    AND POSITION('on conflict' IN pg_catalog.lower(p.prosrc)) = 0\n    AND POSITION('exception' IN pg_catalog.lower(p.prosrc)) = 0\n) AS \"result\"",
        "params": []
      }
    ]
  },
  {
    "id": "trigger.public.auth_identities.auth_identities_provision_user",
    "label": "Create auth identity canonical User provisioning trigger",
    "operationClass": "additive",
    "target": {
      "id": "postgres"
    },
    "precheck": [
      {
        "description": "ensure trigger is absent and provisioning function exists",
        "sql": "SELECT (\n  to_regprocedure($1) IS NOT NULL\n  AND NOT EXISTS (\n    SELECT 1\n    FROM pg_catalog.pg_trigger AS t\n    WHERE t.tgrelid = to_regclass($2)\n      AND t.tgname = $3\n  )\n) AS \"result\"",
        "params": [
          "public.provision_user_for_auth_identity()",
          "public.auth_identities",
          "auth_identities_provision_user"
        ]
      }
    ],
    "execute": [
      {
        "description": "create canonical User provisioning trigger",
        "sql": "CREATE TRIGGER auth_identities_provision_user\nBEFORE INSERT\nON public.auth_identities\nFOR EACH ROW\nEXECUTE FUNCTION public.provision_user_for_auth_identity()",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify provisioning trigger catalog contract",
        "sql": "SELECT EXISTS (\n  SELECT 1\n  FROM pg_catalog.pg_trigger AS t\n  WHERE t.tgrelid = to_regclass('public.auth_identities')\n    AND t.tgname = 'auth_identities_provision_user'\n    AND t.tgenabled = 'O'\n    AND t.tgisinternal = false\n    AND t.tgtype = 7\n    AND t.tgfoid = to_regprocedure('public.provision_user_for_auth_identity()')\n) AS \"result\"",
        "params": []
      }
    ]
  },
