    "execute": [
      {
        "description": "create table \"notifications\"",
        "sql": "CREATE TABLE \"public\".\"notifications\" (\n  \"actor_membership_id\" uuid,\n  \"created_at\" timestamptz NOT NULL,\n  \"home_id\" uuid NOT NULL,\n  \"id\" uuid NOT NULL,\n  \"kind\" text NOT NULL,\n  \"occurred_at\" timestamptz NOT NULL,\n  \"read_at\" timestamptz,\n  \"recipient_membership_id\" uuid NOT NULL,\n  \"source_entity_id\" uuid NOT NULL,\n  \"source_entity_type\" text NOT NULL,\n  \"source_outbox_event_id\" uuid NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"notifications_kind_check_c456c50a\" CHECK (\"kind\" IN ('MEMBERSHIP_ROLE_CHANGED', 'ASSIGNED_TASK_COMPLETED', 'CREATED_SUPPLY_OBTAINED', 'PRIVATE_MAINTENANCE_CREATED', 'PRIVATE_MAINTENANCE_RESOLVED')),\n  CONSTRAINT \"notifications_kind_source_check\" CHECK ((((kind = 'MEMBERSHIP_ROLE_CHANGED'::text) AND (source_entity_type = 'MEMBERSHIP'::text)) OR ((kind = 'ASSIGNED_TASK_COMPLETED'::text) AND (source_entity_type = 'TASK'::text)) OR ((kind = 'CREATED_SUPPLY_OBTAINED'::text) AND (source_entity_type = 'SUPPLY'::text)) OR ((kind = 'PRIVATE_MAINTENANCE_CREATED'::text) AND (source_entity_type = 'MAINTENANCE'::text)) OR ((kind = 'PRIVATE_MAINTENANCE_RESOLVED'::text) AND (source_entity_type = 'MAINTENANCE'::text)))),\n  CONSTRAINT \"notifications_source_entity_type_check_0ee9d6e1\" CHECK (\"source_entity_type\" IN ('MEMBERSHIP', 'TASK', 'SUPPLY', 'MAINTENANCE'))\n)",
        "params": []
      }
    ],
    "postcheck": [
