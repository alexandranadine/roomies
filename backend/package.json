{
  "name": "@roomies/backend",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Roomies Node/Express modular monolith backend",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "contract:emit": "prisma contract emit",
    "migration:plan": "prisma migration plan",
    "db:migrate": "prisma db migrate",
    "db:verify": "prisma db verify"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "prisma": "8.0.0-rc.13",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@prisma/orm-postgres": "8.0.0-rc.9",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.2"
  }
}
